{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/fallow.schema.json",

  // Cloudflare's worker and the shipped D1 example route are entry surfaces
  // wired outside package.json scripts, so static analysis cannot infer them.
  "entry": [
    "worker/index.ts",
    "examples/d1/app/api/notes/route.ts"
  ],

  // Vinext and its App Router/RSC peers are build-time inputs bundled into the
  // Worker output; the deployment does not install them as production modules.
  "ignoreDependencies": [
    "@vitejs/plugin-rsc",
    "react-dom",
    "react-server-dom-webpack",
    "vinext"
  ]
}
