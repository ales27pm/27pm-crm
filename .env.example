# Operator access. Production must contain at least one explicit address.
CRM_ADMIN_EMAILS=owner@example.com
CRM_DEMO_MODE=false

# Web identity. Keep `sites` on the current OpenAI Sites deployment. Use
# `google` only on Vercel after configuring the exact Google OAuth callback
# https://crm.27pm.org/api/auth/callback/google and the three AUTH_* secrets.
CRM_WEB_IDENTITY_PROVIDER=sites
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Split Vercel/Worker runtime. CRM_API_ORIGIN is required only by the Vercel
# web target and must be the dedicated HTTPS Worker origin, never this app's
# own public origin. The Worker uses `hybrid` during migration, then `internal`
# after Sites is retired. Both sides share one dedicated random base64url key.
CRM_API_ORIGIN=
CRM_API_AUTH_MODE=sites
CRM_INTERNAL_API_AUDIENCE=27pm-sites-worker
CRM_INTERNAL_API_SIGNING_KEY=
CRM_SITES_TRUSTED_ORIGIN=https://crm.27pm.org

# Private attachment downloads. Both values belong only to the Worker/Sites
# runtime, never Vercel or client code. The origin must be the exact dedicated
# HTTPS Worker hostname. Use a separate random base64url key of at least 32 bytes.
CRM_ATTACHMENT_DOWNLOAD_ORIGIN=https://files.crm.27pm.org
CRM_ATTACHMENT_DOWNLOAD_SIGNING_KEY=

# Native mobile authorization. The redirect is a public app identifier; the
# signing key is a dedicated base64url-encoded random value of at least 32
# bytes and belongs only in the Worker/Sites secret store, never Vercel. The iOS app ID is the
# public Apple Team ID plus bundle ID used by the Universal Link association.
# Never expose the signing key through EXPO_PUBLIC_* or reuse another key.
CRM_MOBILE_REDIRECT_URI=https://crm.27pm.org/mobile/oauth/callback
CRM_IOS_APP_ID=
CRM_MOBILE_TOKEN_SIGNING_KEY=

# Native chunked-v2 + outbound-only local scanner: independent gates, disabled
# until migration, real same-origin transport, real iOS and restore checks pass.
# Vercel gets ONLY the proxy gate. The remaining values belong to Sites/Worker.
CRM_ATTACHMENT_V2_PROXY_ENABLED=0
ATTACHMENTS_V2_ENABLED=0
CRM_ATTACHMENT_SCANNER_ENABLED=0
CRM_SCANNER_KEY_ID=
CRM_SCANNER_ID=
# Separate runtime machine credential, never OpenAI/mobile/internal-identity key.
# It is NOT created by adding these example names. Keep it server-side only.
CRM_SCANNER_SIGNING_KEY=

# Outbound transport. Mailgun remains the default until a reviewed Exchange
# cutover. Cakemail and Exchange both fail closed behind their provider-specific
# gates; changing this value alone never authorizes a message.
CRM_OUTBOUND_PROVIDER=mailgun

# Exchange connection, bounded folder sync, and mail-flow gates. Connection,
# sync, canary transport, and ordinary messages are separate switches. Keep
# sync false until its migration/restore gates pass, and keep ordinary messages
# false until the exact controlled canary has been received and reviewed.
# All these values belong to the Sites/Worker runtime, never Vercel or clients.
# One single-tenant confidential app and one immutable mailbox object ID.
CRM_EXCHANGE_ENABLED=false
CRM_EXCHANGE_SYNC_ENABLED=false
CRM_EXCHANGE_MAIL_ENABLED=false
# Independent final gate for ordinary CRM messages. Keep false while only the
# exact, dedicated Exchange canary route is authorized.
CRM_EXCHANGE_MESSAGE_SEND_ENABLED=false
CRM_EXCHANGE_TENANT_ID=
CRM_EXCHANGE_MAILBOX_ID=
CRM_EXCHANGE_CLIENT_ID=
CRM_EXCHANGE_CLIENT_SECRET=
# Exactly 32 random bytes, unpadded base64url; dedicated, never reused.
CRM_EXCHANGE_VAULT_KEY=
CRM_EXCHANGE_CALLBACK_ORIGIN=https://api.crm.27pm.org

# Mailgun runtime integration. Use a domain-scoped sending key when possible.
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_DOMAIN=27pm.org
MAILGUN_SENDING_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Optional Cakemail outbound integration. Keep secrets in the runtime secret
# store, not in a committed environment file. See docs/cakemail.md.
CAKEMAIL_PAT=
CAKEMAIL_ACCOUNT_ID=
CAKEMAIL_LIST_ID=
CAKEMAIL_CONTENT_MODE=html
CAKEMAIL_SENDER_ID_BONJOUR=
CAKEMAIL_SENDER_ID_ALEXIS=
CAKEMAIL_SENDER_ID_ADMIN=
# Default: only named recipients with explicit permission, an existing business
# relationship, or a requested response; generic role mailboxes remain blocked.
# written_exception additionally requires the bounded non-secret evidence below.
CAKEMAIL_AUDIENCE_MODE=permission_relationship
CAKEMAIL_PROSPECTING_APPROVED=false
CAKEMAIL_PROSPECTING_APPROVAL_REFERENCE=
CAKEMAIL_PROSPECTING_APPROVAL_SHA256=
# Non-secret exact v2 snapshot of account/list/mode/senders/audience policy that
# received the approvals and canary evidence below. See docs/cakemail.md.
CAKEMAIL_ACTIVATION_BINDING_JSON={}
CAKEMAIL_WEBHOOK_SECRETS_JSON={}
CAKEMAIL_LIST_POLICY_ACCEPTED=false
CAKEMAIL_TRACKING_DOMAIN_READY=false
CAKEMAIL_HEADER_PRESERVATION_CONFIRMED=false
CAKEMAIL_DKIM_ALIGNMENT_CONFIRMED=false

# Local read-only Cakemail activation preflight only. Do not deploy the
# exact-scope audit PAT to Sites; the runtime prefix and hostnames are non-secret.
CAKEMAIL_PREFLIGHT_PAT=
CAKEMAIL_RUNTIME_PAT_PREFIX=
CAKEMAIL_TRACKING_HOSTNAME=track-cakemail.27pm.org
CAKEMAIL_BOUNCE_HOSTNAME=bounce-cakemail.27pm.org

# Controlled Mailgun canary recipients. The Gmail pin remains mandatory; the
# optional Outlook pin is one private, user-controlled @outlook.com mailbox.
# Its SHA-256 approval binds the exact recipient, sender, subject and approved
# base text; the CRM adds only the disclosed identifier/time suffix.
# These settings do not authorize a send. Never commit the actual Outlook address.
CRM_CANARY_RECIPIENT=
CRM_CANARY_OUTLOOK_RECIPIENT=
CRM_CANARY_OUTLOOK_APPROVAL_SHA256=

# Single-use approval digest for one exact solicited reply from the operations
# mailbox. Generate it locally with `npm run operational-reply:approval`, store
# it only as a Sites secret, then remove or rotate it after the attempt.
CRM_OPERATIONAL_REPLY_APPROVAL_SHA256=

# Stable application origin after the custom hostname is attached.
CRM_PUBLIC_ORIGIN=https://crm.27pm.org
# Encryption secret dedicated to opaque public unsubscribe links (at least 32
# random bytes). Generate and store
# only in Sites secrets; never reuse a Mailgun or Turnstile key.
CRM_UNSUBSCRIBE_SIGNING_KEY=
CRM_WEBHOOK_MAX_AGE_SECONDS=900

# Operator-selected deliverability posture. These settings describe and cap
# sending; the CRM never advances a ramp automatically.
CRM_REPUTATION_MODE=normal
CRM_REPUTATION_RAMP_DAY=
CRM_REPUTATION_DAILY_CAP=

# Public form intake. Leave unset to fail closed.
PUBLIC_SITE_ORIGIN=https://27pm.org
TURNSTILE_SECRET_KEY=
PUBLIC_INTAKE_HASH_SALT=
PUBLIC_INTAKE_TURNSTILE_ACTION=crm_intake

# Optional service-to-service CRM integration. Server secrets only; disabled when unset.
CRM_INTEGRATION_TOKEN=
CRM_INTEGRATION_SUBJECT=
CRM_INTEGRATION_SCOPES=
